# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output
*.tfplan

# Sensitive variable overrides — never commit these
*.tfvars.local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock and cache
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Sensitive files that might be generated
github-secrets-generated.md

# OS-specific
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
